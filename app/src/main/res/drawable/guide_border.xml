<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/guide_border.xml
     Marco punteado que guía al técnico a centrar el display del medidor -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <stroke
        android:width="3dp"
        android:color="#AAFFFFFF"
        android:dashWidth="12dp"
        android:dashGap="6dp" />

    <corners android:radius="8dp" />

    <!-- Fondo casi transparente para no tapar la imagen -->
    <solid android:color="#11FFFFFF" />

</shape>
