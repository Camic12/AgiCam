<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Visor de cámara - pantalla completa.
         scaleType=fitCenter: preview muestra el frame completo (lo que se guarda),
         con franjas negras arriba/abajo si hace falta. Igual a OpenCamera. -->
    <androidx.camera.view.PreviewView
        android:id="@+id/visorCamara"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fitCenter"/>

    <!-- Overlay de flash al capturar -->
    <View
        android:id="@+id/capasFlash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:alpha="0"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Indicador de foco (cuadro amarillo animado, posicionado por código) -->
    <View
        android:id="@+id/indicadorFoco"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/borde_foco"
        android:visibility="gone"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- ===== BARRA SUPERIOR ===== -->
    <LinearLayout
        android:id="@+id/barraSuperior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/degradado_superior"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp"
        android:gravity="center_vertical"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/indicadorGPS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⬤ GPS"
            android:textColor="#FF5555"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/fondo_pastilla"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"/>

        <TextView
            android:id="@+id/tvDeteccionIA"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Iniciando IA..."
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:background="@drawable/fondo_pastilla"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/btnFlash"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="⚡"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@drawable/fondo_pastilla"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- Indicador de grabación (tiempo + punto rojo, solo visible al grabar) -->
    <LinearLayout
        android:id="@+id/panelGrabacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/fondo_pastilla"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:elevation="5dp"
        app:layout_constraintTop_toBottomOf="@id/barraSuperior"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp">

        <View
            android:id="@+id/puntoRojoGrab"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/punto_rojo"
            android:layout_marginEnd="8dp"/>

        <Chronometer
            android:id="@+id/cronometroGrabacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- Indicador de nivel de zoom (aparece al hacer zoom, se desvanece) -->
    <TextView
        android:id="@+id/tvNivelZoom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1.0×"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/fondo_pastilla"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@id/selectorModo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="10dp"/>

    <!-- Panel de exposición (aparece al deslizar lado derecho) -->
    <LinearLayout
        android:id="@+id/panelExposicion"
        android:layout_width="44dp"
        android:layout_height="180dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/fondo_pastilla"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:elevation="5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀"
            android:textSize="18sp"
            android:textColor="#FFFFCC00"/>

        <View
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#55FFFFFF"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvValorExposicion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:gravity="center"/>

    </LinearLayout>

    <!-- Banner GPS desactivado (aparece cuando el GPS está apagado) -->
    <LinearLayout
        android:id="@+id/bannerGPSDesactivado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/fondo_pastilla"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="5dp"
        app:layout_constraintTop_toBottomOf="@id/barraSuperior"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS desactivado — "
            android:textColor="#FFFF9500"
            android:textSize="12sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toca para activar"
            android:textColor="#FFFFCC00"
            android:textSize="12sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- ===== SELECTOR DE MODO (FOTO / VIDEO) ===== -->
    <LinearLayout
        android:id="@+id/selectorModo"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:background="@drawable/fondo_pastilla"
        android:elevation="4dp"
        android:padding="3dp"
        app:layout_constraintBottom_toTopOf="@id/barraInferior"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/btnModoFoto"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:text="FOTO"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/fondo_modo_activo"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btnModoVideo"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:text="VIDEO"
            android:textColor="#88FFFFFF"
            android:textSize="12sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- ===== BARRA INFERIOR ===== -->
    <LinearLayout
        android:id="@+id/barraInferior"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:orientation="horizontal"
        android:background="@drawable/degradado_inferior"
        android:gravity="center_vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="12dp"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Miniatura galería con spinner overlay de procesamiento -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp">

            <ImageButton
                android:id="@+id/btnGaleria"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/fondo_galeria_miniatura"
                android:scaleType="centerCrop"
                android:contentDescription="Galería"/>

            <ProgressBar
                android:id="@+id/progresoGuardado"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:indeterminateTint="#FFFFFF"
                android:visibility="gone"/>
        </FrameLayout>

        <!-- Botón central: disparador o grabar -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <!-- Anillo exterior (solo modo foto) -->
            <View
                android:id="@+id/anilloBoton"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/anillo_boton_camara"
                android:layout_gravity="center"/>

            <!-- Botón central (blanco=foto, rojo=video) -->
            <View
                android:id="@+id/btnCapturar"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/fondo_boton_captura"
                android:layout_gravity="center"
                android:clickable="true"
                android:focusable="true"/>

        </FrameLayout>

        <!-- Botón girar cámara (frontal / trasera) -->
        <TextView
            android:id="@+id/btnGirarCamara"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:text="🔄"
            android:textSize="20sp"
            android:gravity="center"
            android:background="@drawable/fondo_pastilla"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
