<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Thumbnail del video (primer frame). centerInside para no recortar. -->
    <ImageView
        android:id="@+id/thumbVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerInside"
        android:contentDescription="Video" />

    <!-- Círculo translúcido con icono de play en el centro -->
    <FrameLayout
        android:id="@+id/btnReproducir"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:background="@android:color/transparent">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/fondo_play_video" />

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_media_play"
            android:contentDescription="Reproducir"
            android:tint="#FFFFFF" />
    </FrameLayout>

</FrameLayout>
